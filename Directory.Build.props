<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <LangVersion>default</LangVersion>
    <!-- The one version of every Vigil binary (vigil, vigild, the macOS bundle, the Windows zip). The packaging scripts and
         the release workflow read it with: dotnet msbuild src/Vigil/Vigil.csproj -getProperty:Version -->
    <Version>0.1.0</Version>
  </PropertyGroup>
</Project>
