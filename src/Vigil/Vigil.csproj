<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>vigil</AssemblyName>
    <Version>0.1.0</Version>
    <RootNamespace>Vigil</RootNamespace>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Vigil.Core/Vigil.Core.csproj" />
    <ProjectReference Include="../Vigil.Platform.MacOS/Vigil.Platform.MacOS.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Vigil.Tests" />
  </ItemGroup>
</Project>
